{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "dispositivos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$deviceId": {
        ".write": "auth != null && newData.child('firebaseUid').val() == auth.uid",
        ".validate": "newData.hasChildren(['modelo', 'androidId', 'firebaseUid', 'plataforma', 'estado', 'timestamp']) && newData.child('androidId').val() == $deviceId && newData.child('firebaseUid').val() == auth.uid"
      }
    },
    "deviceAuth": {
      "$deviceId": {
        ".read": "auth != null && (auth.uid == root.child('dispositivos').child($deviceId).child('firebaseUid').val() || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}
